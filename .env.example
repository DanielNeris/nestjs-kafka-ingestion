# Kafka brokers (comma-separated). Use localhost:9092 locally, kafka:19092 in Docker.
KAFKA_BROKERS=localhost:9092
# Silence KafkaJS v2 partitioner warning
KAFKAJS_NO_PARTITIONER_WARNING=1
# OpenSearch node URL. Use http://opensearch:9200 in Docker.
OPENSEARCH_NODE=http://localhost:9200
# Confluent Schema Registry URL. Use http://schema-registry:8081 in Docker.
SCHEMA_REGISTRY_URL=http://localhost:8081
# HTTP port (api-gateway: 3000, wikimedia-producer: 3001)
PORT=3000
